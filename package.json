{
  "name": "dsh-remote-portal",
  "version": "0.2.9",
  "description": "为 DeepSeek Harness 添加远程访问能力，支持局域网和公网访问。Remote access for DeepSeek Harness: LAN and public access.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "install.ps1",
    "tools",
    "docs/*.md",
    "docs/screenshots/*.png",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:host": "node --test test/host.test.mjs",
    "test:relay": "node --test test/relay.test.mjs",
    "relay": "node tools/relay.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-access",
    "reverse-proxy",
    "tunnel",
    "relay",
    "mobile",
    "gateway",
    "qr-pairing"
  ],
  "license": "MIT",
  "author": "dsh-remote-portal contributors"
}


